// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  FAMILY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Room {
  id                String   @id @default(uuid())
  name              String
  type              RoomType
  description       String?
  capacity          Int
  basePricePerNight Decimal  @db.Decimal(10, 2)
  currency          String   @default("EUR")
  imageUrls         String[]
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservations Reservation[]
}

model Guest {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  reservations Reservation[]
}

// Overlapping (roomId, checkInDate, checkOutDate) ranges for PENDING/CONFIRMED
// reservations are blocked by a hand-written GiST exclusion constraint added in
// the initial migration (Prisma's schema language can't express it directly).
model Reservation {
  id              String            @id @default(uuid())
  room            Room              @relation(fields: [roomId], references: [id])
  roomId          String
  guest           Guest             @relation(fields: [guestId], references: [id])
  guestId         String
  checkInDate     DateTime          @db.Date
  checkOutDate    DateTime          @db.Date
  numberOfGuests  Int
  status          ReservationStatus @default(PENDING)
  totalPrice      Decimal           @db.Decimal(10, 2)
  currency        String            @default("EUR")
  specialRequests String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payment Payment?

  @@index([roomId, checkInDate, checkOutDate])
}

// amount is stored in minor units (cents) to mirror Stripe's PaymentIntent.amount.
model Payment {
  id                    String        @id @default(uuid())
  reservation           Reservation   @relation(fields: [reservationId], references: [id])
  reservationId         String        @unique
  stripePaymentIntentId String        @unique
  amount                Int
  currency              String        @default("EUR")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

// Caches machine-translated site copy so the same English source string is
// never sent to the translation provider twice for a given target locale.
model TranslationCache {
  id             String   @id @default(uuid())
  locale         String
  sourceHash     String
  sourceText     String
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([locale, sourceHash])
}
