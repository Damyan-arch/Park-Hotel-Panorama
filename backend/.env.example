# App
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:4201

# Database (matches docker-compose.yml postgres service)
DATABASE_URL="postgresql://park_hotel:park_hotel_dev_password@localhost:5432/park_hotel?schema=public"

# Stripe (test-mode keys from the Stripe dashboard)
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret

# DeepL (free account at https://www.deepl.com/pro-api) — powers auto-translation
# of site copy into Bulgarian/German/Spanish/Romanian. Free-tier keys end in ":fx"
# and must use the api-free host below; paid keys should override DEEPL_API_URL
# to https://api.deepl.com/v2/translate.
DEEPL_API_KEY=replace-with-your-deepl-api-key
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Admin area (hidden /admin login). JWT_SECRET signs admin session tokens —
# use a long random string. ADMIN_EMAIL/ADMIN_PASSWORD are only read once,
# by `npm run db:seed`, to create the single admin user row.
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-admin-password
